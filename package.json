{
  "name": "cam-cheat-sheet",
  "version": "0.1.0",
  "description": "Camera settings cheat sheet - scene-based presets and exposure triangle simulator",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "camera",
    "photography",
    "cheat-sheet",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src index.html",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "lucide": "^1.77.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
