{
  "name": "cam-cheat-sheet",
  "version": "0.1.0",
  "description": "Camera settings cheat sheet - scene-based presets and exposure triangle simulator",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "camera",
    "photography",
    "cheat-sheet",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src index.html",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.18.0",
    "typescript": "^7.1.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "lucide": "^0.552.0"
  }
}
